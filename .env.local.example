# Copy to .env.local and fill in from your Supabase project settings.
# Never commit .env.local — it's in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only in trusted server contexts (never exposed to the browser) —
# e.g. AI extraction service calls. Do not prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Resend (transactional email for the reminder engine's email channel —
# src/services/core/email.ts). Get a key at resend.com/api-keys.
RESEND_API_KEY=
# Verified sending address — must match a domain verified in your Resend
# account (resend.com/domains), e.g. notifications@your-actual-domain.com.
# Without a verified domain, you can only send using onboarding@resend.dev,
# and only to the email address your Resend account itself is registered
# with. Never leave this as a placeholder — an unverified/invalid sender
# will cause every email send to fail.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Base URL used to build links inside reminder emails (never real medical
# content — see services/core/email.ts). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (VAPID) — the reminder engine's push channel (src/lib/push/
# web-push.ts). Generate your own pair with `npx web-push generate-vapid-
# keys`. The public key is safe to expose to the browser (that's what
# NEXT_PUBLIC_ means); the private key must never be — it signs every
# push request server-side and is read only in src/lib/push/web-push.ts.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service can reach you at if it needs to flag
# a problem with your sending pattern — any mailto:/https: URI works.
VAPID_SUBJECT=mailto:support@example.com
